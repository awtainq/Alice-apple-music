#!/bin/sh
set -eu
for attempt in $(seq 1 100); do
 if ip link show music-home >/dev/null 2>&1; then break; fi
 sleep 0.1
done
/usr/local/bin/awg setconf music-home /etc/amnezia/amneziawg/music-home.conf
ip address replace 10.10.10.5/32 dev music-home
ip link set music-home mtu 1280 up
ip route replace 10.10.10.1/32 dev music-home
ip route replace 192.168.1.0/24 dev music-home
