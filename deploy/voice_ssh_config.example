Host station-music
    HostName 192.168.1.100
    Port 2222
    User root
    BatchMode yes
    StrictHostKeyChecking yes
    UserKnownHostsFile /var/lib/alice-music/private/station_known_hosts
    # For key-based SSH, provision a dedicated key and uncomment:
    # IdentityFile /var/lib/alice-music/private/station_voice_ed25519
    # IdentitiesOnly yes
    ExitOnForwardFailure yes
    ServerAliveInterval 15
    ServerAliveCountMax 3
    LocalForward 127.0.0.1:19875 127.0.0.1:9875
