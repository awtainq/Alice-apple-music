[Unit]
Description=AmneziaWG connection to home for Alice Music
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Environment=GOMAXPROCS=2
Environment=LOG_LEVEL=error
UMask=0077
ExecStart=/usr/local/bin/amneziawg-go -f music-home
ExecStartPost=/usr/local/libexec/alice-music-vpn-up
ExecStopPost=-/usr/sbin/ip link delete music-home
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
