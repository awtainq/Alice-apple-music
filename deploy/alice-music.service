[Unit]
Description=Native Alice Apple Music player
Requires=alice-music-vpn.service
Wants=network-online.target
After=network-online.target alice-music-vpn.service

[Service]
Type=simple
User=alice-music
Group=alice-music
WorkingDirectory=/opt/alice-music/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/alice-music/venv/bin/python /opt/alice-music/app/service.py --private /var/lib/alice-music/private --cache /var/cache/alice-music
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/alice-music /var/cache/alice-music
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryHigh=192M
MemoryMax=384M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
